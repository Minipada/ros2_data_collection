# External source repos this workspace needs alongside ros2_data_collection itself,
# for `vcs import` (see doc/src/dc/setup.md). vector_vendor was split out of this repo
# (see docs/adr/0002-vector-as-default-shipper.md's amendment) so its binary content's
# growth doesn't land in ros2_data_collection's own git history; aws_sdk_vendor lives
# here too for layout consistency across vendor packages, even though its own content
# (a thin ament_vendor() recipe with no vendored source) carries no such bloat — see
# docs/adr/0012-aws-sdk-vendor-flattened-source.md. Pinned to a tag, not a branch, so a
# workspace built from a given ros2_data_collection commit is reproducible.
repositories:
  vector_vendor:
    type: git
    url: https://github.com/Minipada/vector_vendor.git
    version: v0.57.0
  aws_sdk_vendor:
    type: git
    url: https://github.com/Minipada/aws_sdk_vendor.git
    version: v1.11.600
  # Source-built on the lyrical line: its rosdistro resolves
  # nlohmann_json_schema_validator_vendor but the resolute .deb isn't published yet
  # (#531), so rosdep can't install it there. Pinned to main (vendored upstream v2.4.0):
  # 0.6.0's upstream predates the json_pointer to_string() fixes and deprecation-warns all
  # over the build against the resolute nlohmann 3.11.3. Drop once
  # ros-lyrical-nlohmann-json-schema-validator-vendor ships.
  nlohmann_json_schema_validator_vendor:
    type: git
    url: https://github.com/open-rmf/nlohmann_json_schema_validator_vendor.git
    version: 43358d96f0a458f798d2d347d18ef7177042d304
  # Source-built on the lyrical line, for the only two navigation2 packages whose
  # resolute .debs never published (#531): nav2_smac_planner (its farm build fails on
  # the OMPL deb's missing Boost CMake metadata, ompl#1457) and nav2_bringup, blocked
  # transitively — plus the navigation2 metapackage, which nav2_bringup find_packages
  # at configure time. The rest of the monorepo is trimmed at vcs-import time and those
  # packages install as .debs — see tools/e2e/Containerfile. Pinned to the tip of
  # navigation2's own lyrical branch. Drop once ros-lyrical-nav2-bringup ships —
  # together with the trim and the skips in tools/e2e/Containerfile.
  navigation2:
    type: git
    url: https://github.com/ros-navigation/navigation2.git
    version: 3c3c1e8f11e62ee376a1ced66a51e2607e940ebd
