# External source repos this workspace needs alongside ros2_data_collection itself,
# for `vcs import` (see doc/src/dc/setup.md). vector_vendor was split out of this repo
# (see docs/adr/0002-vector-as-default-shipper.md's amendment) so its binary content's
# growth doesn't land in ros2_data_collection's own git history; aws_sdk_vendor lives
# here too for layout consistency across vendor packages, even though its own content
# (a thin ament_vendor() recipe with no vendored source) carries no such bloat — see
# docs/adr/0012-aws-sdk-vendor-flattened-source.md. Pinned to a tag, not a branch, so a
# workspace built from a given ros2_data_collection commit is reproducible.
repositories:
  vector_vendor:
    type: git
    url: https://github.com/Minipada/vector_vendor.git
    version: v0.57.0
  aws_sdk_vendor:
    type: git
    url: https://github.com/Minipada/aws_sdk_vendor.git
    version: v1.11.600
  # Source-built on this branch: navigation2 has no rolling release yet — nothing in
  # the monorepo ships as a ros-rolling-* .deb — so the sim's bringup stack (amcl,
  # map_server, planner/controller servers, bt_navigator, ...) can only come from
  # source. navigation2's `main` branch IS its rolling development head, so the branch
  # ref (not a SHA pin) is what keeps this tracking rolling head: every rebuild of this
  # layer clones whatever main is then, and an upstream break is this branch's CI
  # failing. The rviz plugin (GUI, never launched headless) and system_tests (nav2's
  # own integration suite, not ours to gate) are trimmed at vcs-import time — see
  # tools/e2e/Containerfile, which also skips their tests. Drop once ros-rolling-nav2-*
  # ships — together with the trim and the test skips in tools/e2e/Containerfile.
  navigation2:
    type: git
    url: https://github.com/ros-navigation/navigation2.git
    version: main
