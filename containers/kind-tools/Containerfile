# kind + kubectl, pinned, for tools/kind/ (#452). Built and pushed once by CI's
# build-kind-tools-image job, then pulled by verify-kind-networkpolicy — install the
# tools once, at image-build time (cached: rebuilding with the same ARGs is a
# --cache-from hit, same mechanism build-workspace uses for its own rarely-changing
# layers), reuse the built image on every run, instead of every job re-downloading both
# binaries itself. verify-kind-networkpolicy extracts them with `podman cp` — it never
# runs this image directly, since kind needs the runner's own Docker daemon, not one
# nested inside a container.
FROM docker.io/library/debian:trixie-slim

ARG KIND_VERSION=v0.33.0
ARG KUBECTL_VERSION=v1.31.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /usr/local/bin/kind "https://kind.sigs.k8s.io/dl/${KIND_VERSION}/kind-linux-amd64" \
    && curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kind /usr/local/bin/kubectl
