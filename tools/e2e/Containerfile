# Full DC workspace (every dc_* package, all C++) — three stages:
# - `cacher`: extracts just the package manifests (package.xml) from the full source
#   tree, so `toolchain`'s COPY --from below keys its own cache on dependency lists
#   alone, not on every source edit — without having to hardcode one COPY per package.
# - `toolchain-base`: a small stable apt layer (git + vcstool), then `vcs import`s
#   ros2_data_collection.repos — vector_vendor and aws_sdk_vendor (docs/adr/0002,
#   docs/adr/0012) plus navigation2, which rolling doesn't release at all yet (.repos
#   for why it is source-built and tracks `main`) — then the daily-busted
#   dist-upgrade + the remaining OS packages every later stage needs (ccache, lcov,
#   pip tools). The fetch tools stay above the cache-bust layer; the import itself
#   sits under it, so it re-resolves every source once per UTC day — that daily
#   re-resolution is what makes navigation2's branch ref track its head instead of
#   silently freezing it. Split from `toolchain` below so this stage's cache keys stay
#   `ros2_data_collection.repos`'s own content, not the full-workspace rosdep install
#   `toolchain` adds on top.
# - `toolchain`: `toolchain-base` + pre-built aws-sdk-cpp + full-workspace rosdep
#   install. Stays a cache hit across ordinary source changes; re-runs caused by
#   parent invalidation (daily cache-bust, .repos/rosdep changes) compile from the
#   shared dc-ccache mount, so the ~15-min aws-sdk-cpp build only pays cold once.
# - `workspace`: inherits toolchain, COPYs the full source, then one `colcon build` +
#   `colcon test`. Three `RUN --mount=type=cache` mounts persist across builds
#   independently of the layer they are attached to: `dc-ccache` (compiler object
#   files, shared with toolchain's aws_sdk_vendor build, so a change to one file only
#   recompiles that file's translation unit), `dc-apt` (downloaded .deb archives, so
#   re-running rosdep install on the same package set skips the network round-trip)
#   and `dc-pip` (wheels for toolchain-base's pip install). Mount ids carry a
#   `-${ROS_DISTRO}` suffix so two distros can never share cached content (#530).
#   All three mounts live
#   under buildah's own
#   $TMPDIR/buildah-cache/<id>, entirely separate from --cache-from/--cache-to's
#   registry export (which only carries *layers*, not cache-mount content — verified
#   against two live CI runs, not assumed); on a fresh runner they survive only if the
#   caller points $TMPDIR somewhere that persists itself, which is what CI's
#   BUILDAH_TMPDIR (build.sh) + actions/cache does. Local dev gets no such
#   persistence unless it does the same.
#
# CI and local dev build this exact same Containerfile the exact same way
# (./tools/e2e/scripts/build.sh) — no bind-mounted host cache dirs, no podman-cp,
# no separate finalize step producing the shippable image.
#
# `--packages-skip aws_sdk_vendor` on the workspace stage's build/test: its build/ and
# install/ trees are already part of the toolchain stage this stage is FROM (built
# once — see below), so skipping it here avoids re-running its ~15-minute
# aws-sdk-cpp source build on every image, not just every source change.
#
# Plain ROS 2 + C++: no separate language toolchain, no source-built message repos.
# dc_bridge builds with rosdep + colcon like every other dc_* package.

# The one distro lever (#530): build.sh forwards ROS_DISTRO here, and every stage
# redeclares it (ARG scope resets at FROM) so its RUNs — rosdep, setup sourcing, and
# the distro-suffixed cache-mount ids — derive the distro instead of hardcoding one.
# A changed value invalidates the stage anyway through the FROM below, so unlike
# APT_CACHEBUST (see toolchain-base) top placement here costs no extra invalidation.
ARG ROS_DISTRO=rolling

# --- cacher: nothing but the package manifests, so this stage's own frequent cache
# invalidation (it COPYs the whole repo) costs nothing — it does no compilation, and
# only its OUTPUT's content (not whether this stage itself was a cache hit) determines
# whether the toolchain stage's COPY --from below stays a cache hit.
FROM docker.io/library/ros:${ROS_DISTRO}-ros-base AS cacher
WORKDIR /root/ws
COPY . src/ros2_data_collection
# `-exec … +` rather than `| xargs`: this stage sets no pipefail SHELL (only the
# toolchain stage below does), so a pipe here would hide a failing `find` — hadolint
# DL4006/SC2038.
RUN mkdir -p /tmp/manifests && \
    find src/ros2_data_collection -name package.xml -exec cp --parents -t /tmp/manifests {} +

FROM docker.io/library/ros:${ROS_DISTRO}-ros-base AS toolchain-base

ARG ROS_DISTRO=rolling

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Stable fetch-tools layer — deliberately ahead of the daily cache-bust RUN below so
# the `vcs import` layered on top of it is not invalidated once per UTC day (git/vcstool
# still get their security patches: the dist-upgrade below upgrades every package
# installed here, and the layer cache keys on instruction text, so a newer git in the
# archive alone doesn't re-run this layer).
#
# dc-apt: apt's .deb archive dir as a `RUN --mount=type=cache` mount, same mechanics
# as the workspace stage's dc-ccache below (buildah stores it under
# $TMPDIR/buildah-cache/dc-apt, so it survives this layer's invalidation — the daily
# APT_CACHEBUST refresh included). docker-clean is rewritten rather than deleted: its
# Post-Invoke hooks rm every .deb after each apt-get, which would empty the mount, but
# its pkgcache-off half is kept — without it apt writes a tens-of-MB pkgcache.bin into
# the RUN's layer on every update. The rewrite persists into every later stage of this
# chain (toolchain, workspace). /var/lib/apt/lists stays ephemeral: every RUN
# re-fetches indexes via apt-get update anyway, so mounting them would save no
# downloads while adding shared mutable state across builds.
# Every apt RUN below ends by removing archives/partial too: apt creates it _apt-owned
# 0700 inside the dc-apt mount, and CI's actions/cache tars this tree as the runner user
# post-job — one unreadable file aborts the whole save, taking dc-ccache with it (#531).
# apt recreates the dir itself on the next download.
RUN --mount=type=cache,id=dc-apt-${ROS_DISTRO},target=/var/cache/apt/archives \
    printf 'Dir::Cache::pkgcache "";\nDir::Cache::srcpkgcache "";\n' \
      > /etc/apt/apt.conf.d/docker-clean && \
    apt-get -q update && \
    apt-get -q install --no-install-recommends -y git python3-vcstool && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/partial

WORKDIR /root/ws

# Daily apt cache-bust (see CLAUDE.md "Containers: Podman, not Docker"): a date-valued
# build-arg rebuilds the apt layer once per UTC day so OS security patches don't go stale.
# Its own RUN layer (no DC source) so it stays a cache hit across code changes.
#
# The ARG is declared HERE — after the stable fetch-tools layer, before the `vcs
# import` and its only apt RUN: buildah carries every in-scope build-arg in each RUN's
# environment, so its cache key picks up the arg's value even for RUNs that never
# reference it. That is wanted for the import, not just tolerated: navigation2's
# .repos entry is a branch ref (main, its rolling head), and an import layered above
# the bust would silently re-serve the last-cloned commit from cache forever — the
# daily re-resolution here is what makes it track rolling head. The two pinned vendor
# tags re-resolve to the same SHAs for the cost of a shallow clone.
ARG APT_CACHEBUST=unknown

# The .repos sources are fetched into the workspace source tree the same way a
# developer's own `vcs import` would, before anything downstream can `colcon build`
# them. Keying the fetch on ros2_data_collection.repos's content (a separate COPY, not
# folded into an apt RUN) is what keeps aws_sdk_vendor's ~15-minute aws-sdk-cpp source
# build (#271, in the `toolchain` stage below) a cache hit across ordinary source
# edits elsewhere in ros2_data_collection. `vcs import` needs network; every later
# `colcon build`/`colcon test` in downstream stages runs against the
# already-materialized result.
COPY ros2_data_collection.repos .
# navigation2 is source-built (see ros2_data_collection.repos): rolling has no
# ros-rolling-nav2-* debs at all yet, so the sim's bringup stack can only come from
# source. Two directories are trimmed at import time: nav2_rviz_plugins (a GUI plugin
# — qt6/rviz deps and build minutes for a stack this branch never launches headed) and
# nav2_system_tests (navigation2's own integration suite, not ours to gate). Trim,
# .repos entry and the nav2 test skips below go together once ros-rolling-nav2-*
# ships.
RUN mkdir -p src/ros2_data_collection && \
    vcs import --shallow src/ros2_data_collection < ros2_data_collection.repos && \
    find src/ros2_data_collection/navigation2 -mindepth 1 -maxdepth 1 -type d \
      \( -name nav2_rviz_plugins -o -name nav2_system_tests \) -exec rm -rf {} +
# fastcov: tools/code_coverage_report.bash's C++ coverage tool; lcov/ccache round it out.
# mold: linker for every dc_* link step — ~35 plugin .so + ~50 gtest binaries per build,
# and ccache caches objects, not links.
# mcap: dc_mcap_writer's (#210/ADR-0009) one Python dependency. `colcon build`'s
# ament_python step installs each package with `pip install --no-deps`, deliberately
# never fetching a package's `install_requires` over the network at build time — so
# listing `mcap` in dc_mcap_writer/setup.py alone does not make it importable here; it
# has to be installed into this image explicitly, same as fastcov below.
# libboost-serialization-dev: the source-built nav2_smac_planner's configure resolves
# omplConfig.cmake, whose find_dependency(Boost serialization) needs CMake metadata the
# ompl deb doesn't declare (ompl#1457) — here until that packaging fix lands.
#
# dc-pip keeps pip's wheel cache on a mount (fastcov/mcap are unpinned, so every daily
# re-run re-resolves them; the mount means the re-resolution re-downloads nothing).
RUN --mount=type=cache,id=dc-apt-${ROS_DISTRO},target=/var/cache/apt/archives \
    --mount=type=cache,id=dc-pip-${ROS_DISTRO},target=/root/.cache/pip \
    echo "apt cache bust: ${APT_CACHEBUST}" && \
    apt-get -q update && \
    apt-get -q -y dist-upgrade && \
    apt-get -q install --no-install-recommends -y \
    libboost-serialization-dev python3-pip ccache lcov mold && \
    pip install --break-system-packages fastcov mcap && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/partial

FROM toolchain-base AS toolchain

ARG ROS_DISTRO=rolling

# aws_sdk_vendor's source already arrived via toolchain-base's `vcs import` above, so
# building it here only needs the local rosdep source it depends on registering.
# rosdep/dc.yaml is registered as a local rosdep source so `rosdep install` resolves
# tomlplusplus / msgpack-cxx (header-only C++ libs dc_bridge uses that upstream
# rosdistro has no key for — see dc_bridge/package.xml). It's registered here, in the
# `toolchain` stage, rather than beside the full-workspace rosdep install below, so
# `rosdep update`'s index fetch only happens once. The full-workspace build later
# reuses this layer's already-built install/ via `colcon build --packages-skip
# aws_sdk_vendor`.
COPY rosdep src/ros2_data_collection/rosdep
# Mounts (see toolchain-base): dc-apt for the rosdep install's .debs, and dc-ccache —
# same id as the workspace stage below, flag-keyed entries coexisting — for the
# aws_sdk_vendor build. This layer re-runs whenever a parent invalidates (daily
# APT_CACHEBUST, a .repos or rosdep/ change), but the ~15-min aws-sdk-cpp compile only
# pays cold once: afterwards ccache serves every object whose preprocessed input
# (headers included) didn't change, and the re-run costs mostly linking.
RUN --mount=type=cache,id=dc-apt-${ROS_DISTRO},target=/var/cache/apt/archives \
    --mount=type=cache,id=dc-ccache-${ROS_DISTRO},target=/root/.ccache \
    echo "yaml file:///root/ws/src/ros2_data_collection/rosdep/dc.yaml" \
      > /etc/ros/rosdep/sources.list.d/10-dc.list && \
    apt-get -q update && \
    rosdep update --include-eol-distros && \
    # slam_toolbox / nav2_rviz_plugins: nav2_bringup's own package.xml declares both,
    # neither releases into rolling today (slam_toolbox not in the rosdistro at all,
    # the rviz plugin trimmed at import time above). Neither is on the sim's bringup
    # path (localization is AMCL, not SLAM; nothing here launches rviz) — skip their
    # resolution. Goes when ros-rolling-nav2-* ships, with the .repos entry.
    DEBIAN_FRONTEND=noninteractive \
    rosdep install -y --from-paths src --ignore-src --rosdistro ${ROS_DISTRO} --as-root=apt:false \
      --skip-keys="slam_toolbox nav2_rviz_plugins" && \
    # shellcheck disable=SC1091
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --packages-select aws_sdk_vendor \
      --cmake-args -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
      -DCMAKE_LINKER_TYPE=MOLD \
      --event-handlers desktop_notification- status- && \
    ccache -s && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/partial

# Full-workspace rosdep install for system (apt) dependencies — nav2_common,
# cv_bridge, ffmpeg, etc. — baked into this image, not left to a later stage that
# would never persist them into the final shippable image. `COPY --from=cacher` pulls
# in every package.xml the `cacher` stage found (see above) in one instruction, so this
# layer's cache key is the manifests' own content — it invalidates only when a
# dependency list changes, not on an ordinary source edit.
COPY --from=cacher /tmp/manifests/src ./src
RUN --mount=type=cache,id=dc-apt-${ROS_DISTRO},target=/var/cache/apt/archives \
    apt-get -q update && \
    # Same two nav2-satellite skips as the toolchain stage above; the nav2 trees
    # themselves resolve via --ignore-src, since cacher's copy merges into the
    # imported src/ this stage inherits.
    DEBIAN_FRONTEND=noninteractive rosdep install -y --from-paths src --ignore-src --rosdistro ${ROS_DISTRO} --as-root=apt:false \
      --skip-keys="slam_toolbox nav2_rviz_plugins" && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/partial

# --- workspace: full source + colcon build + colcon test, in one image both CI and
# local dev build the same way (./tools/e2e/scripts/build.sh) ---
FROM toolchain AS workspace

# ARG scope resets at every `FROM`, even `FROM toolchain AS workspace` — without this
# redeclaration, `--build-arg CCOV=true` would silently never reach this stage's RUN
# below (CCOV would just read as unset/false here), producing a plain Release build
# with no error. This exact bug was found and fixed earlier in this branch's history.
ARG CCOV=false
ARG ROS_DISTRO=rolling

COPY . src/ros2_data_collection

# The ccache mount persists across builds independently of this RUN's own layer cache
# (which still invalidates on every source change, since COPY . above does) — so a
# change to one file only recompiles that file's translation units; ccache serves the
# rest from its mount, *provided* $TMPDIR points somewhere that persists between
# invocations (buildah stores the mount under $TMPDIR/buildah-cache/dc-ccache — not
# part of the image, not covered by --cache-from/--cache-to, which only carry
# layers). CI arranges that via build.sh's BUILDAH_TMPDIR + an actions/cache step;
# a plain local build gets no such persistence. dc-apt (the rosdep install's .deb
# cache — see toolchain-base) rides the same mechanism.
#
# colcon test-result doesn't accept --packages-skip (unlike colcon build/test) and
# doesn't need it — it only scans build/ subdirectories that exist, and
# aws_sdk_vendor's build/ dir is a vendored third-party dependency with no tests of
# its own. colcon test's own exit code and colcon test-result's are captured
# separately (rather than letting a test failure abort the RUN early) so the coverage
# report below still runs even when a test fails. The combined result is written to
# /root/ws/TEST_RESULT rather than failing the RUN/build itself: a failing `RUN` means
# podman never tags an image at all, so the caller (ci.yaml) would have nothing to
# `podman run` the coverage data out of. ci.yaml checks TEST_RESULT itself, after
# extracting coverage, and only pushes the image when it reads 0.
#
# SC2086: NAV2_PKGS below is meant to word-split into one skip name per package.
# hadolint ignore=SC2086
RUN --mount=type=cache,id=dc-ccache-${ROS_DISTRO},target=/root/.ccache \
    --mount=type=cache,id=dc-apt-${ROS_DISTRO},target=/var/cache/apt/archives \
    apt-get -q update && \
    # Same two nav2-satellite skips as the toolchain stage above.
    DEBIAN_FRONTEND=noninteractive rosdep install -y --from-paths src --ignore-src --rosdistro ${ROS_DISTRO} --as-root=apt:false \
      --skip-keys="slam_toolbox nav2_rviz_plugins" && \
    # shellcheck disable=SC1091
    . /opt/ros/${ROS_DISTRO}/setup.sh && \
    if [ "$CCOV" = "true" ]; then \
      CMAKE_ARGS="-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS='-Wall -Wextra --coverage -O0 -fno-omit-frame-pointer' -DCMAKE_EXE_LINKER_FLAGS=--coverage -DCMAKE_SHARED_LINKER_FLAGS=--coverage -DCMAKE_LINKER_TYPE=MOLD"; \
    else \
      CMAKE_ARGS="-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_BUILD_TYPE=Release -DCMAKE_LINKER_TYPE=MOLD"; \
    fi && \
    eval colcon build --packages-skip aws_sdk_vendor --cmake-args "$CMAKE_ARGS" --event-handlers desktop_notification- status- && \
    ccache -s && \
    # shellcheck disable=SC1091
    . install/setup.bash && \
    # navigation2's source-built packages (ros2_data_collection.repos) land in the
    # workspace build above — but their test suites (system_tests among them) are not
    # ours to gate. The loop and the skips go when ros-rolling-nav2-* ships, together
    # with the .repos entry and the trim in toolchain-base.
    NAV2_PKGS="" && \
    for d in src/ros2_data_collection/navigation2/*/; do \
      if [ -f "${d}package.xml" ]; then NAV2_PKGS="${NAV2_PKGS}$(basename "${d}") "; fi; \
    done && \
    ( colcon test --packages-skip aws_sdk_vendor ${NAV2_PKGS} --event-handlers desktop_notification- status- ; echo $? > /tmp/test_exit ) && \
    ( colcon test-result --verbose ; echo $? > /tmp/result_exit ) && \
    ( src/ros2_data_collection/tools/code_coverage_report.bash ci || echo "warning: coverage report generation produced no data (non-coverage build?)" >&2 ) && \
    mkdir -p coverage && \
    ( [ -f lcov/total_coverage.info ] && cp lcov/total_coverage.info coverage/cpp.info || true ) && \
    TEST_EXIT=$(cat /tmp/test_exit) && RESULT_EXIT=$(cat /tmp/result_exit) && \
    if [ "$TEST_EXIT" -ne 0 ] || [ "$RESULT_EXIT" -ne 0 ]; then echo "colcon test reported failures" >&2; echo 1 > TEST_RESULT; else echo 0 > TEST_RESULT; fi && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/partial

ENV ROS_UNDERLAY=/root/ws/install
# What the sim scripts' `source /opt/ros/${ROS_DISTRO:-rolling}/setup.bash` reads at
# runtime (podman exec inherits the image env) — the image knows its own distro.
ENV ROS_DISTRO=${ROS_DISTRO}
RUN echo "source ${ROS_UNDERLAY}/setup.bash" >> /etc/bash.bashrc

# --- runtime: slim, deployable image — install/ only, exec-only system deps, no
# source tree, no build/log dirs, no build toolchain (build-essential/git/ccache/
# lcov/colcon extensions). containers/dc-ros and containers/dc-uploader FROM this
# instead of `workspace`, which was a thin FROM on the raw CI test/coverage image
# (source tree, build/log dirs and all) — 16.9GB for what ships to a robot.
#
# `COPY --from=workspace` pulls from the stage above *in this file*, so building
# `--target runtime` implicitly builds `workspace` first with whatever `CCOV`
# build-arg was passed — this is one stage, built twice (CCOV=false and CCOV=true),
# not two stages to maintain. See ci.yaml's build-workspace / build-workspace-coverage.
FROM docker.io/library/ros:${ROS_DISTRO}-ros-base AS runtime

ARG ROS_DISTRO=rolling

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /root/ws

# --dependency-types=exec (rosdep, not colcon) resolves only <exec_depend>/<depend>
# system packages — no compilers, no -dev headers, no build-essential. Relies on
# dc_* package.xml files tagging deps correctly rather than the catch-all <depend>
# for anything build-only.
#
# --skip-keys for the two vendors and the nav2 packages: dc_bridge/dc_measurements
# depend on the vendors, and dc packages declare the nav2 keys, but unlike the
# toolchain stage above, this stage never `vcs import`s anything (it starts fresh
# FROM ros-base, deliberately skipping toolchain's git/ccache/build-essential layers),
# so cacher's manifest-only copy has no package.xml for any of them — rosdep sees an
# unresolvable name instead of a local package satisfied via --ignore-src. All of them
# are already fully linked into the install/ tree copied in below (the vendors built
# by toolchain, nav2 by the workspace build — rolling ships no ros-rolling-nav2-* debs
# to install instead); nothing here needs to resolve their own transitive deps as apt
# packages. The nav2 skip list goes when ros-rolling-nav2-* ships, together with the
# .repos entry and the trim in toolchain-base.
COPY --from=cacher /tmp/manifests/src ./src
COPY rosdep src/ros2_data_collection/rosdep
# dc-apt + the docker-clean rewrite (see toolchain-base). The rewrite is mandatory
# here, not hygiene: this stage starts fresh FROM ros-base with the stock docker-clean,
# whose Post-Invoke rm would wipe the .debs out of the dc-apt mount every other stage
# in this build shares. This layer only invalidates when the manifests or rosdep/
# change, and when it does the exec-dep .debs are already in dc-apt from toolchain's
# (build+exec) rosdep install above — a dependency bump re-downloads nothing here.
RUN --mount=type=cache,id=dc-apt-${ROS_DISTRO},target=/var/cache/apt/archives \
    printf 'Dir::Cache::pkgcache "";\nDir::Cache::srcpkgcache "";\n' \
      > /etc/apt/apt.conf.d/docker-clean && \
    echo "yaml file:///root/ws/src/ros2_data_collection/rosdep/dc.yaml" \
      > /etc/ros/rosdep/sources.list.d/10-dc.list && \
    apt-get -q update && \
    rosdep update --include-eol-distros && \
    DEBIAN_FRONTEND=noninteractive rosdep install -y --from-paths src --ignore-src --rosdistro ${ROS_DISTRO} \
      --as-root=apt:false --dependency-types=exec \
      --skip-keys="aws_sdk_vendor vector_vendor nav2_bringup nav2_common nav2_lifecycle_manager nav2_msgs nav2_ros_common nav2_simple_commander nav2_util" && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/partial src

COPY --from=workspace /root/ws/install install

ENV ROS_UNDERLAY=/root/ws/install
ENV ROS_DISTRO=${ROS_DISTRO}
RUN echo "source ${ROS_UNDERLAY}/setup.bash" >> /etc/bash.bashrc
