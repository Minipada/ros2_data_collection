<?xml version="1.0"?>
<model>
  <name>warehouse</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>DC 2.0 migration (#357)</name>
    <email>d.bensoussan@proton.me</email>
  </author>
  <description>
    Local placeholder standing in for MOV.AI's Warehouse Fuel model (CC-BY-NC-ND-4.0), which
    forbade commercial use and derivatives. A floor slab and perimeter walls, matching the
    original mesh's true footprint and collision boundary (30m x 50m, walls at x=+-15/y=+-25,
    same thickness, south wall split around a 15m loading-dock opening at x in [-7.5, 7.5]) so
    the pre-baked localization map at dc_simulation/maps/qrcodes.{pgm,yaml} stays valid without
    regenerating it -- every wall segment's footprint was checked against that map's occupied
    cells. The original's gabled roof, ceiling trusses, support columns and floor decals are
    visual-only detail above or irrelevant to a ground robot's 2D lidar plane and are not
    reproduced. See issue #357.
  </description>
</model>
