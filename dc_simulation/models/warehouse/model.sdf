        </geometry>
        <material>
          <ambient>0.75 0.75 0.72 1</ambient>
          <diffuse>0.75 0.75 0.72 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- South wall has a 15m loading-dock opening centred at x=0, flanked by door-jamb
           columns at x=+-7.5 (measured off the pre-baked localization map's occupied
           cells, dc_simulation/maps/qrcodes.pgm — see model.config). Two segments, not
           one wall, so the gap stays open. -->
      <collision name="wall_south_west_collision">
        <pose>-11.25 -24.975 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>7.5 0.05 10</size>
          </box>
        </geometry>
      </collision>
      <visual name="wall_south_west_visual">
        <pose>-11.25 -24.975 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>7.5 0.05 10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.72 1</ambient>
          <diffuse>0.75 0.75 0.72 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="wall_south_east_collision">
        <pose>11.25 -24.975 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>7.5 0.05 10</size>
          </box>
        </geometry>
      </collision>
      <visual name="wall_south_east_visual">
        <pose>11.25 -24.975 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>7.5 0.05 10</size>
          </box>
        </geometry>
        <material>
