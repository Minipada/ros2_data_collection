<?xml version="1.0"?>
<sdf version="1.6">
  <model name="warehouse">
    <static>true</static>
    <link name="warehouse_base">
      <collision name="floor_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>30 50 0.1</size>
          </box>
        </geometry>
      </collision>
      <visual name="floor_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>30 50 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.52 1</ambient>
          <diffuse>0.5 0.5 0.52 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="wall_west_collision">
        <pose>-14.925 0 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 50 10</size>
          </box>
        </geometry>
      </collision>
      <visual name="wall_west_visual">
        <pose>-14.925 0 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 50 10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.72 1</ambient>
          <diffuse>0.75 0.75 0.72 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="wall_east_collision">
        <pose>14.925 0 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 50 10</size>
          </box>
        </geometry>
      </collision>
      <visual name="wall_east_visual">
        <pose>14.925 0 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 50 10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.72 1</ambient>
          <diffuse>0.75 0.75 0.72 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="wall_north_collision">
        <pose>0 24.975 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>30 0.05 10</size>
          </box>
        </geometry>
      </collision>
      <visual name="wall_north_visual">
        <pose>0 24.975 5.1 0 0 0</pose>
        <geometry>
          <box>
            <size>30 0.05 10</size>
