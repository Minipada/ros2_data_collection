<?xml version="1.0"?>
<model>
  <name>construction_cone</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>DC 2.0 migration (#268)</name>
    <email>d.bensoussan@proton.me</email>
  </author>
  <description>
    Local placeholder standing in for construction_cone, previously sourced from
    aws_robomaker_small_warehouse_world / the Gazebo Classic online model
    database — neither has a Gazebo Harmonic (gz-sim) port, so this simple
    primitive-geometry box/cylinder keeps the warehouse world's prop
    dressing self-contained (no external Fuel network dependency at
    build/run time). See issue #268.
  </description>
</model>
