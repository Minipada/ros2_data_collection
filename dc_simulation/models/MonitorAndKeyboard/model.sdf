<?xml version="1.0"?>

<sdf version="1.6">
  <model name='MonitorAndKeyboard'>
    <!--
      monitor.obj/keyboard.obj were never checked into the repo (only their
      textures/.mtl survived) -- gz-sim's SDF loader hard-fails on an
      unresolvable mesh uri (Gazebo Classic only warned and skipped
      rendering it), so #268 replaces the geometry with box placeholders.
    -->
    <static>true</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

      <visual name="visual_monitor">
        <geometry>
          <box>
            <size>0.4 0.05 0.35</size>
          </box>
        </geometry>
        <pose>0 0 0.2 0 0 0</pose>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <collision name="collision_monitor">
        <geometry>
          <box>
            <size>0.4 0.05 0.35</size>
          </box>
        </geometry>
        <pose>0 0 0.2 0 0 0</pose>
      </collision>

      <visual name="visual_keyboard">
        <geometry>
          <box>
            <size>0.35 0.15 0.02</size>
          </box>
        </geometry>
        <pose>-0.27 0 0.01 0 0 0</pose>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <collision name="collision_keyboard">
        <geometry>
          <box>
            <size>0.35 0.15 0.02</size>
          </box>
        </geometry>
        <pose>-0.27 0 0.01 0 0 0</pose>
      </collision>

    </link>
  </model>
</sdf>
