repositories:
  # rosidl_generator_rs (the Rust message-binding code generator) isn't in the Jazzy
  # sync yet, and pre-built apt message packages don't carry Rust bindings either — only
  # source-built ones do. These are the message repos dc_bridge (ADR-0004, #244) actually
  # needs rebuilt from source to get Rust crates for std_msgs/std_srvs (dc_bridge) and
  # sensor_msgs (dc_interfaces). Pinned to the `jazzy` branch, matching how every other
  # ROS dependency in this repo tracks its distro branch rather than a fixed commit.
  common_interfaces:
    type: git
    url: https://github.com/ros2/common_interfaces.git
    version: jazzy
  rcl_interfaces:
    type: git
    url: https://github.com/ros2/rcl_interfaces.git
    version: jazzy
  rosidl_core:
    type: git
    url: https://github.com/ros2/rosidl_core.git
    version: jazzy
  rosidl_defaults:
    type: git
    url: https://github.com/ros2/rosidl_defaults.git
    version: jazzy
  unique_identifier_msgs:
    type: git
    url: https://github.com/ros2/unique_identifier_msgs.git
    version: jazzy
  # The code generator itself. Pinned to the exact commit verified against in #244
  # (rather than a floating `main`) because it and rosidl_runtime_rs (a plain Cargo
  # dependency, pinned in dc_bridge/Cargo.lock instead) are developed in lockstep and
  # have drifted out of sync before — see dc_bridge/README.md. This SHA wasn't hand
  # picked for stability: it's just whatever `main` happened to be when this was first
  # cloned. It turns out to also be what upstream's own `noble-jazzy` bloom-release
  # branch was generated from as of 2026-07-18 ("Generated from 0a67d22" in that
  # branch's tip commit message) — a lucky match discovered after the fact, not the
  # reason it was chosen. `noble-jazzy` itself isn't used here since bloom branches get
  # regenerated to newer commits over time, which would defeat the point of pinning.
  rosidl_rust:
    type: git
    url: https://github.com/ros2-rust/rosidl_rust.git
    version: 0a67d22d9f44c5956f9da7161b011910b7129335
