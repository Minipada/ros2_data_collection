<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dc_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridge node (C++): subscribes to StringStamped Record topics and forwards them to the
    Vector shipper over the Fluent Forward protocol, rendering Vector's config from ROS
    parameters for the blessed Destination set (ADRs 0001/0003/0006). ADR-0007 reverts
    the ADR-0004 Rust pilot: the Bridge is plain ament_cmake C++, so it builds with
    rosdep + colcon like every other dc_* package.
  </description>
  <maintainer email="d.bensoussan@proton.me">David Bensoussan</maintainer>
  <license>MPL-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>dc_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nlohmann-json-dev</depend>
  <!-- tomlplusplus (Vector-config render/parse) and msgpack-cxx (Fluent Forward framing)
       have no upstream rosdistro rosdep keys; rosdep/dc.yaml (registered as a local
       rosdep source — see dc_bridge/README.md and tools/e2e/Containerfile) maps them to
       libtomlplusplus-dev / libmsgpack-cxx-dev so `rosdep install` resolves them. -->
  <depend>tomlplusplus</depend>
  <depend>msgpack-cxx</depend>
  <!-- The AWS SDK for C++ (s3), built from source — the Uploader's object-storage client
       (ADR-0005). -->
  <depend>aws_sdk_vendor</depend>

  <exec_depend>vector_vendor</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
