<package format="3">
  <name>dc_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridge node (C++): subscribes to StringStamped Record topics and forwards them to the
    Vector shipper over the Fluent Forward protocol, rendering Vector's config from ROS
    parameters for the blessed Destination set (ADRs 0001/0003/0006/0007). Plain
    ament_cmake C++, so it builds with rosdep + colcon like every other dc_* package.
  </description>
  <maintainer email="d.bensoussan@proton.me">David Bensoussan</maintainer>
  <license>MPL-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>dc_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <!-- Runtime message introspection for raw / generic-subscription mode (#227): types
       the Bridge was never compiled against are deserialized and walked through these,
       the same pair `ros2 bag record -a` uses. Core ROS packages — no new rosdep source
       needed, unlike tomlplusplus/msgpack-cxx below. -->
  <depend>rosidl_runtime_cpp</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>rcpputils</depend>
  <depend>nlohmann-json-dev</depend>
  <!-- tomlplusplus (Vector-config render/parse) and msgpack-cxx (Fluent Forward framing)
       have no upstream rosdistro rosdep keys; rosdep/dc.yaml (registered as a local
       rosdep source — see dc_bridge/README.md and tools/e2e/Containerfile) maps them to
       libtomlplusplus-dev / libmsgpack-cxx-dev so `rosdep install` resolves them. -->
  <depend>tomlplusplus</depend>
  <depend>msgpack-cxx</depend>
  <!-- The AWS SDK for C++ (s3), built from source — the Uploader's object-storage client
       (ADR-0005). -->
  <depend>aws_sdk_vendor</depend>

  <exec_depend>vector_vendor</exec_depend>
  <!-- The Uploader's media toolchain, used as subprocesses rather than linked (see
       include/dc_bridge/uploader/thumbnail.hpp for why): `ffprobe` for the `duration`
       column on video Files (ADR-0005) and `ffmpeg` for the optional thumbnails of
       #256. One package provides both. Neither is needed to *build* dc_bridge, and
       both are optional at runtime — a missing binary degrades to "no duration" / "no
       thumbnail", never to a failed upload — but declaring it is what makes an
       ordinary `rosdep install` produce a Bridge with both features working. -->
  <exec_depend>ffmpeg</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <!-- Tests only (uploader_test, #290): dc_common's header-only FileScratchRing, so the Files
       pipeline can be exercised against a File staged exactly the way an armed Measurement
       stages it. The Bridge itself has no incident-capture code and depends on none of it. -->
  <test_depend>dc_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
